    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-virtual": "^3.14.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}

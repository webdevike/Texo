{
  "name": "@texo/ui",
  "version": "0.1.0",
  "description": "Texo UI system: Mantine under stable Base* names plus Texo composites, presets, and the workspace bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webdevike/Texo",
    "directory": "packages/ui"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/texo-ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./src/mantine.ts",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack": "pnpm build && pnpm pack --pack-destination ../../dist/packages"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/code-highlight": "9.6.0",
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-virtual": "^3.14.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
